<Window x:Class="BatteryTray.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BatteryTray.UI"
        Title="{l:T overlay.header}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Focusable="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
    <!-- Downscaling keeps unusually large device lists inside the work area without dropping devices. -->
    <Viewbox x:Name="Fit" Stretch="Uniform" StretchDirection="DownOnly">
        <Border x:Name="Frame" Background="#ED202020" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="{l:T none.online}" TextWrapping="Wrap" Margin="8,6"/>
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,5" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="19"
                                           Foreground="{Binding Brush}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Name}" Visibility="{Binding NameVisibility}" MaxWidth="140"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Level}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="18"
                                           Visibility="{Binding PowerVisibility}" Foreground="{Binding Brush}" Margin="3,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Viewbox>
</Window>

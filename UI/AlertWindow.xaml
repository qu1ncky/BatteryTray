<Window x:Class="BatteryTray.UI.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BatteryTray.UI"
        Title="{l:T alert.title}" Width="408" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">

    <Border x:Name="Frame" Margin="16" CornerRadius="8" Background="{StaticResource CardBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Border x:Name="AccentBar" Width="4" HorizontalAlignment="Left" CornerRadius="8,0,0,8"/>
            <StackPanel Margin="22,14,14,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleGlyph" Style="{StaticResource Glyph}" Text="&#xE850;" FontSize="20"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right"
                            ToolTip="{l:T alert.snooze.tip}" Click="Snooze_Click"/>
                </Grid>

                <ItemsControl x:Name="Items" Margin="0,10,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Level}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{Binding Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="HintText" FontSize="12" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,8,8,0"/>

                <StackPanel Margin="0,14,8,0">
                    <Button x:Name="SnoozeButton" Style="{StaticResource AccentButton}" Click="Snooze_Click"/>
                    <Button x:Name="MuteButton" Content="{l:T alert.mute}" Margin="0,8,0,0" Click="Mute_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="BatteryTray.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заряд устройств" Width="440" Height="640" MinWidth="380" MinHeight="420"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Device that is on the air right now -->
        <DataTemplate x:Key="DeviceCard">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="22"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Subtitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="16" Margin="0,0,4,0"
                                   Foreground="{Binding LevelBrush}">
                            <TextBlock.Visibility>
                                <Binding Path="Charging">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <TextBlock Text="{Binding LevelText}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{Binding LevelBrush}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FillWidth}"/>
                            <ColumnDefinition Width="{Binding RestWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource TrackBrush}"/>
                        <Border CornerRadius="2" Background="{Binding LevelBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Device that is off or out of range -->
        <DataTemplate x:Key="OfflineRow">
            <Grid Margin="16,6,16,6" Opacity="0.75">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DeviceSettingsRow">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18"/>
                        <TextBox Grid.Column="1" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding DefaultName}" ToolTip="Своё название; пусто — как называет себя устройство"/>
                    </Grid>
                    <TextBlock Margin="34,4,0,0" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                               Text="{Binding Source}"/>
                    <CheckBox Style="{StaticResource Toggle}" Content="Показывать в списке" Margin="34,12,0,0"
                              IsChecked="{Binding Visible}"/>
                    <CheckBox Style="{StaticResource Toggle}" Content="Напоминать о разряде" Margin="34,10,0,0"
                              IsChecked="{Binding Alerts}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,14,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,6,0">
            <TextBlock Text="Заряд устройств" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                    ToolTip="Опросить устройства сейчас" Click="Refresh_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-14,10,0,14">
            <RadioButton x:Name="DevicesTab" Style="{StaticResource TabButton}" Content="Устройства" IsChecked="True"
                         Checked="Tab_Checked"/>
            <RadioButton x:Name="SettingsTab" Style="{StaticResource TabButton}" Content="Настройки" Margin="2,0,0,0"
                         Checked="Tab_Checked"/>
        </StackPanel>

        <ScrollViewer x:Name="DevicesView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10"
                        BorderBrush="{StaticResource AccentBrush}" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="16" Margin="0,0,10,0"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="UpdateBannerButton" Style="{StaticResource AccentButton}" Content="Обновить"
                                HorizontalAlignment="Right" Padding="12,5" Click="InstallUpdate_Click"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="OnlineList" ItemTemplate="{StaticResource DeviceCard}"/>
                <Border x:Name="NoOnline" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <TextBlock Text="Сейчас ни одно устройство не на связи" Foreground="{StaticResource SecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="OfflineHeader" Text="Не на связи" Style="{StaticResource SectionHeader}" Margin="2,14,0,4"/>
                <ItemsControl x:Name="OfflineList" ItemTemplate="{StaticResource OfflineRow}"/>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                      Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Напоминания" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Напоминать, когда заряд ниже"/>
                            <TextBlock x:Name="LowValue" HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <Slider x:Name="LowSlider" Minimum="10" Maximum="50" TickFrequency="5" SmallChange="5"
                                LargeChange="5" Margin="0,6,0,14" ValueChanged="Setting_Changed"/>

                        <Grid>
                            <TextBlock Text="Критический уровень"/>
                            <TextBlock x:Name="CriticalValue" HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <Slider x:Name="CriticalSlider" Minimum="5" Maximum="45" TickFrequency="5" SmallChange="5"
                                LargeChange="5" Margin="0,6,0,4" ValueChanged="Setting_Changed"/>
                        <TextBlock Text="На нём напоминание появится снова, даже если вы его отложили"
                                   FontSize="12" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <TextBlock Text="Повторять напоминание каждые"/>
                            <TextBlock x:Name="RepeatValue" HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <Slider x:Name="RepeatSlider" Minimum="5" Maximum="60" TickFrequency="5" SmallChange="5"
                                LargeChange="5" Margin="0,6,0,14" ValueChanged="Setting_Changed"/>

                        <CheckBox x:Name="SoundToggle" Style="{StaticResource Toggle}" Content="Звуковой сигнал"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>
                <Button Content="Показать пример напоминания" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Click="TestAlert_Click"/>

                <TextBlock Text="Устройства" Style="{StaticResource SectionHeader}" Margin="2,22,0,8"/>
                <ItemsControl x:Name="DeviceSettingsList" ItemTemplate="{StaticResource DeviceSettingsRow}"/>

                <TextBlock Text="Обновления" Style="{StaticResource SectionHeader}" Margin="2,14,0,8"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdateNotesText" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,14">
                            <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                    Click="InstallUpdate_Click" Visibility="Collapsed"/>
                            <Button x:Name="CheckUpdatesButton" Content="Проверить сейчас" Click="CheckUpdates_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle}"
                                  Content="Устанавливать обновления автоматически"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="Новая версия ставится, пока окна программы закрыты, и программа сама перезапускается."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Система" Style="{StaticResource SectionHeader}" Margin="2,14,0,8"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Toggle}"
                                  Content="Запускать при входе в Windows" Click="AutoStart_Click"/>
                        <TextBlock x:Name="ElevationText" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="Открыть папку с логом и настройками" HorizontalAlignment="Left" Margin="0,8,0,8"
                        Click="OpenFolder_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,6,0">
            <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="{StaticResource SecondaryBrush}"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>

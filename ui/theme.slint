// The app's look: the Windows 11 dark palette, and the few controls the windows share. The main window's own
// controls are in controls.slint.

export global Palette {
    out property <color> window: #202020;
    out property <color> card: #2B2B2B;
    out property <color> stroke: #363636;
    out property <color> control: #323232;
    out property <color> control-hover: #3B3B3B;
    out property <color> control-pressed: #2A2A2A;
    out property <color> input: #1F1F1F;
    out property <color> text: #F3F3F3;
    out property <color> secondary: #9E9E9E;
    out property <color> track: #404040;
    out property <color> accent: #60CDFF;
    out property <color> accent-hover: #85D9FF;
    out property <color> good: #6CCB5F;
    out property <color> warn: #F7C04A;
    out property <color> bad: #FF6B6B;
    out property <color> offline: #7A7A7A;
    // Menus, dropdown lists, tooltips and key caps
    out property <color> popup: #2C2C2C;
    out property <color> popup-stroke: #4A4A4A;
    // The name of a device without connection
    out property <color> dim-text: #B4B4B4;
    // The window's colour at half strength: laid over a block it fades it as a whole, which `opacity` doesn't do
    // with the software renderer (it fades every shape on its own, and overlapping ones show through each other)
    out property <color> scrim: #20202080;
}

// The app's texts: Rust answers T.tr(language, key); a binding that reads `lang` follows a change of language.
export global T {
    in-out property <string> lang: "en";
    // Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10
    in property <string> icon-font: "Segoe Fluent Icons";
    pure callback tr(string, string) -> string;
    public pure function t(key: string) -> string {
        return self.tr(self.lang, key);
    }
}

export component Glyph inherits Text {
    font-family: T.icon-font;
    font-size: 20px;
    color: Palette.secondary;
    vertical-alignment: center;
    accessible-role: none;
}

export component Card inherits Rectangle {
    background: Palette.card;
    border-color: Palette.stroke;
    border-width: 1px;
    border-radius: 8px;
}

export component SectionHeader inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Palette.secondary;
}

export component Hint inherits Text {
    font-size: 12px;
    color: Palette.secondary;
    wrap: word-wrap;
}

export component Btn inherits Rectangle {
    in property <string> text;
    // What a screen reader says, when the text alone would not tell this button from another one
    in property <string> accessible-text: root.text;
    in property <bool> accent;
    in property <bool> enabled: true;
    in property <length> padding-x: 14px;
    callback clicked();
    min-height: 32px;
    border-radius: 4px;
    border-width: 1px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.accent
        ? (touch.has-hover && root.enabled && !touch.pressed ? Palette.accent-hover : Palette.accent)
        : (touch.pressed ? Palette.control-pressed : touch.has-hover && root.enabled ? Palette.control-hover : Palette.control);
    border-color: root.accent ? self.background : Palette.stroke;
    accessible-role: button;
    accessible-label: root.accessible-text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        padding-top: 6px;
        padding-bottom: 6px;
        label := Text {
            text: root.text;
            color: root.accent ? #000000 : Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <length> glyph-size: 15px;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 4px;
    background: touch.pressed ? Palette.control-pressed : touch.has-hover ? Palette.control-hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    Glyph {
        text: root.glyph;
        font-size: root.glyph-size;
        color: Palette.text;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Slider in steps (5%), the part up to the knob in the accent color. As the switches (SwitchRow in controls.slint), it
// only asks for a value (`changed`); `value` shows what the app has, also when it moves another slider along (the
// critical level stays 5 below the reminder level). The knob stays on the track for a value the slider can't reach
// (the repeat field takes 1 to 120 minutes, the slider goes from 5 to 60).
export component StepSlider {
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 5;
    in property <string> label;
    in property <int> value;
    callback changed(int);
    height: 24px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.set(root.value + root.step); }
    accessible-action-decrement => { root.set(root.value - root.step); }
    property <length> knob-x: (root.width - 20px)
        * max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    function set(v: int) {
        let snapped = max(root.minimum, min(root.maximum, v));
        if (snapped != root.value) {
            root.changed(snapped);
        }
    }
    function set-from(x: length) {
        let ratio = max(0, min(1, (x - 10px) / (root.width - 20px)));
        root.set(root.minimum + round(ratio * (root.maximum - root.minimum) / root.step) * root.step);
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Palette.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.knob-x + 10px;
        height: 4px;
        border-radius: 2px;
        background: Palette.accent;
    }
    Rectangle {
        x: root.knob-x;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #454545;
        border-color: #555555;
        border-width: 1px;
        Rectangle {
            width: touch.has-hover ? 13px : 10px;
            height: self.width;
            border-radius: self.width / 2;
            background: Palette.accent;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// The app's look: the Windows 11 palette, dark or light, and the few controls the windows share. The main window's
// own controls are in controls.slint.

// The light values are Windows 11's light theme flattened over the surface they sit on; every text colour reads at
// 4.5:1 at least on the window, a card, a popup and a field.
export global Palette {
    // Windows' light app mode: Rust sets it for each window and follows a change. The overlay never gets it: it
    // stays dark over games.
    in property <bool> light;
    // The colours' place between the dark ones (0) and the light ones (1). One of the two for a window in its
    // colours; while an open window follows a change of `light`, Rust takes it from one to the other in the time
    // Windows takes to recolour the title bar (gui::fade_theme), so that the window and its title bar change together.
    in property <float> mix;
    out property <color> window: pick(#F3F3F3, #202020);
    out property <color> card: pick(#FBFBFB, #2B2B2B);
    out property <color> stroke: pick(#E5E5E5, #363636);
    // A card marked as the one being worked on (its menu open, its name being typed): one step stronger than `stroke`
    out property <color> stroke-strong: pick(#D1D1D1, #4A4A4A);
    out property <color> control: pick(#FEFEFE, #323232);
    // Light: see-through black rather than a grey, so a hover shows the same on the window, a card and a popup. A
    // control's fill gives way to them, and what shows through is only what the control sits on.
    out property <color> control-hover: pick(#0000000A, #3B3B3B);
    out property <color> control-pressed: pick(#00000006, #2A2A2A);
    out property <color> input: pick(#FFFFFF, #1F1F1F);
    out property <color> text: pick(#1A1A1A, #F3F3F3);
    out property <color> secondary: pick(#5F5F5F, #9E9E9E);
    out property <color> track: pick(#E0E0E0, #404040);
    out property <color> accent: pick(#005FB8, #60CDFF);
    out property <color> accent-hover: pick(#1A6FBF, #85D9FF);
    // Text and glyphs on an accent fill (the accent buttons, selected text)
    out property <color> on-accent: pick(#FFFFFF, #000000);
    // The levels' colours; view::Tone::rgb has the same for the tray
    out property <color> good: pick(#0F7B0F, #6CCB5F);
    out property <color> warn: pick(#9D5D00, #F7C04A);
    out property <color> bad: pick(#C42B1C, #FF6B6B);
    out property <color> offline: pick(#8A8A8A, #7A7A7A);
    // Menus, dropdown lists, tooltips and key caps
    out property <color> popup: pick(#F9F9F9, #2C2C2C);
    out property <color> popup-stroke: pick(#DEDEDE, #4A4A4A);
    // Under what floats over the window: menus, dropdown lists and the dialog; the tooltip; the lifted card
    out property <color> shadow: pick(rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.5));
    out property <color> tip-shadow: pick(rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.45));
    out property <color> lift-shadow: pick(rgba(0, 0, 0, 0.14), rgba(0, 0, 0, 0.55));
    // The name of a device without connection
    out property <color> dim-text: pick(#474747, #B4B4B4);
    // The window's colour at half strength: laid over a block it fades it as a whole, which `opacity` doesn't do
    // with the software renderer (it fades every shape on its own, and overlapping ones show through each other)
    out property <color> scrim: pick(#F3F3F380, #20202080);
    // Behind the dialog: the window steps back
    out property <color> dialog-scrim: pick(#0000004D, #000000A0);
    // The place a dragged device would drop into
    out property <color> accent-wash: pick(rgba(0, 95, 184, 0.06), rgba(96, 205, 255, 0.06));
    // A switch: the frame and the knob when off, the knob when on (on the accent)
    out property <color> switch-stroke: pick(#8B8B8B, #9A9A9A);
    out property <color> knob-off: pick(#5F5F5F, #CFCFCF);
    out property <color> knob-on: pick(#FFFFFF, #1A1A1A);
    // A slider's knob and its frame
    out property <color> thumb: pick(#FFFFFF, #454545);
    out property <color> thumb-stroke: pick(#CCCCCC, #555555);

    // A colour's light and dark values: the one of them at either end of `mix`, exactly, and evenly from one to the
    // other in between, as Windows fades a title bar
    pure function pick(in-light: color, in-dark: color) -> color {
        if (self.mix >= 1) {
            return in-light;
        }
        if (self.mix <= 0) {
            return in-dark;
        }
        in-light.mix(in-dark, self.mix)
    }

    // A level's colour by its tone (view::Tone::index): good, warn, bad, charging, no level
    public pure function tone(index: int) -> color {
        if (index == 0) {
            return self.good;
        }
        if (index == 1) {
            return self.warn;
        }
        if (index == 2) {
            return self.bad;
        }
        if (index == 3) {
            return self.accent;
        }
        self.offline
    }
}

// The app's texts: Rust answers T.tr(language, key); a binding that reads `lang` follows a change of language.
export global T {
    in-out property <string> lang: "en";
    // Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10
    in property <string> icon-font: "Segoe Fluent Icons";
    pure callback tr(string, string) -> string;
    public pure function t(key: string) -> string {
        return self.tr(self.lang, key);
    }
}

export component Glyph inherits Text {
    font-family: T.icon-font;
    font-size: 20px;
    color: Palette.secondary;
    vertical-alignment: center;
    accessible-role: none;
}

export component Card inherits Rectangle {
    background: Palette.card;
    border-color: Palette.stroke;
    border-width: 1px;
    border-radius: 8px;
}

export component SectionHeader inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Palette.secondary;
}

// "New" in a small outlined capsule after the header of a section that is new in this version; taken away in the
// next one. The Mac app has the same (NewBadge in SettingsWindow.swift).
export component NewBadge inherits Rectangle {
    width: label.preferred-width + 12px;
    height: 16px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Palette.accent;
    // How far the word's letters rise from their baseline: a word in small letters alone ("новое") as far as an x,
    // any other ("New", "新") as far as a capital
    property <bool> small-letters: label.text == label.text.to-lowercase() && label.text != label.text.to-uppercase();
    property <length> rise: self.small-letters ? label.font-metrics.x-height : label.font-metrics.cap-height;
    label := Text {
        text: T.t("settings.new");
        font-size: 11px;
        font-weight: 600;
        color: Palette.accent;
        horizontal-alignment: center;
        vertical-alignment: top;
        height: self.preferred-height;
        // The letters in the capsule's middle, not their line: a line keeps more room above its letters than below
        // them, so a word without a tall letter sat a pixel and a half low. The line, where the font doesn't say
        // how tall its letters are.
        y: root.rise > 0 ? (parent.height + root.rise) / 2 - self.font-metrics.ascent : (parent.height - self.height) / 2;
    }
}

export component Hint inherits Text {
    font-size: 12px;
    color: Palette.secondary;
    wrap: word-wrap;
}

export component Btn inherits Rectangle {
    in property <string> text;
    // What a screen reader says, when the text alone would not tell this button from another one
    in property <string> accessible-text: root.text;
    in property <bool> accent;
    in property <bool> enabled: true;
    in property <length> padding-x: 14px;
    callback clicked();
    min-height: 32px;
    border-radius: 4px;
    border-width: 1px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.accent
        ? (touch.has-hover && root.enabled && !touch.pressed ? Palette.accent-hover : Palette.accent)
        : (touch.pressed ? Palette.control-pressed : touch.has-hover && root.enabled ? Palette.control-hover : Palette.control);
    border-color: root.accent ? self.background : Palette.stroke;
    accessible-role: button;
    accessible-label: root.accessible-text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        padding-top: 6px;
        padding-bottom: 6px;
        label := Text {
            text: root.text;
            color: root.accent ? Palette.on-accent : Palette.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <length> glyph-size: 15px;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 4px;
    background: touch.pressed ? Palette.control-pressed : touch.has-hover ? Palette.control-hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    Glyph {
        text: root.glyph;
        font-size: root.glyph-size;
        color: Palette.text;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Slider in steps (5% unless told otherwise), the part up to the knob in the accent color. As the switches (SwitchRow
// in controls.slint), it only asks for a value (`changed`); `value` shows what the app has, also when it moves another
// slider along (the critical level is never above the reminder level). The knob stays on the track for a value the
// slider can't reach (the fields take more than their sliders: the repeat field 1 to 99 999 minutes, its slider 1 to
// 60).
export component StepSlider {
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 5;
    in property <string> label;
    in property <int> value;
    callback changed(int);
    height: 24px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.set(root.value + root.step); }
    accessible-action-decrement => { root.set(root.value - root.step); }
    property <length> knob-x: (root.width - 20px)
        * max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    function set(v: int) {
        let snapped = max(root.minimum, min(root.maximum, v));
        if (snapped != root.value) {
            root.changed(snapped);
        }
    }
    function set-from(x: length) {
        let ratio = max(0, min(1, (x - 10px) / (root.width - 20px)));
        root.set(root.minimum + round(ratio * (root.maximum - root.minimum) / root.step) * root.step);
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Palette.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.knob-x + 10px;
        height: 4px;
        border-radius: 2px;
        background: Palette.accent;
    }
    Rectangle {
        x: root.knob-x;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Palette.thumb;
        border-color: Palette.thumb-stroke;
        border-width: 1px;
        Rectangle {
            width: touch.has-hover ? 13px : 10px;
            height: self.width;
            border-radius: self.width / 2;
            background: Palette.accent;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

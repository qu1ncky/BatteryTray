// The settings screen: the back button and the title, three tabs, and a page for each. Every value comes from
// Rust; changes go back through the callbacks.

import { ScrollView } from "std-widgets.slint";
import { Palette, T, Glyph, Card, SectionHeader, NewBadge, Hint, Btn, StepSlider } from "theme.slint";
import { SwitchRow, TipButton, InfoTip, NumberField, Dropdown, WideButton, ShortcutField, Divider, OverlayTabGlyph, Collapsible } from "controls.slint";

// One of the three tabs: a glyph and a label, centred, and a bar along the bottom, in the accent colour under the
// current one
component SettingsTab inherits Rectangle {
    in property <string> text;
    // "" for the overlay tab, whose glyph is drawn
    in property <string> glyph;
    in property <bool> checked;
    callback clicked();
    // Thirds of the strip whatever the labels: stretch alone shares out only what is left after each tab's own
    // width
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: touch.has-hover ? Palette.card : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    property <color> ink: root.checked ? Palette.text : Palette.secondary;
    HorizontalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 6px;
        alignment: center;
        if root.glyph != "": Glyph {
            width: 15px;
            text: root.glyph;
            font-size: 15px;
            color: root.ink;
            horizontal-alignment: center;
        }
        if root.glyph == "": VerticalLayout {
            alignment: center;
            OverlayTabGlyph {
                ink: root.ink;
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: root.ink;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: 3px;
        border-radius: 1.5px;
        background: root.checked ? Palette.accent : Palette.track;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The frame of the settings screen. The pages are its children, stacked and hidden rather than destroyed: a field
// that has the focus when its page goes then loses it and commits, and the window can still reach them by name.
export component SettingsScreen inherits Rectangle {
    in property <int> tab;
    callback back();
    callback tab-clicked(int);
    VerticalLayout {
        padding-top: 14px;
        padding-right: 14px;
        padding-bottom: 12px;
        padding-left: 20px;
        // The back arrow's left edge is in line with the content: the button's own padding stands out to the left
        HorizontalLayout {
            padding-right: 6px;
            padding-left: -8px;
            spacing: 4px;
            TipButton {
                width: 34px;
                height: 34px;
                glyph: "\u{E72B}";
                glyph-size: 16px;
                tip: T.t("back");
                clicked => { root.back(); }
            }
            Text {
                text: T.t("settings");
                font-size: 22px;
                font-weight: 600;
                color: Palette.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            padding-top: 10px;
            padding-right: 6px;
            padding-bottom: 14px;
            spacing: 4px;
            accessible-role: tab-list;
            SettingsTab {
                text: T.t("general.header");
                glyph: "\u{E713}";
                checked: root.tab == 0;
                clicked => { root.tab-clicked(0); }
            }
            SettingsTab {
                text: T.t("alerts.header");
                glyph: "\u{EA8F}";
                checked: root.tab == 1;
                clicked => { root.tab-clicked(1); }
            }
            SettingsTab {
                text: T.t("overlay.header");
                checked: root.tab == 2;
                clicked => { root.tab-clicked(2); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            @children
        }
    }
}

// A page of its own scroll view: the cards, 8px apart
component Page inherits Rectangle {
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding-right: 6px;
            spacing: 8px;
            @children
        }
    }
}

// A row of a settings card with a control on its right: the label wraps, the control keeps its size
component ControlRow inherits HorizontalLayout {
    in property <string> text;
    in property <string> leading-glyph;
    min-height: 48px;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 12px;
    if root.leading-glyph != "": Glyph {
        width: 20px;
        text: root.leading-glyph;
        font-size: 18px;
        horizontal-alignment: center;
    }
    Text {
        text: root.text;
        color: Palette.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

// "General": autostart, language and theme, updates, the log folder, ideas
export component GeneralPage inherits Page {
    in property <bool> autostart;
    in property <string> language;
    // "light", "dark", or "auto" to follow Windows
    in property <string> theme;
    in property <string> tray-priority;
    in property <bool> tray-battery-icon;
    in property <bool> hide-offline;
    in property <string> update-status;
    in property <string> update-checked-text;
    in property <string> update-notes;
    in property <bool> install-visible;
    in property <string> install-text;
    in property <bool> check-enabled;
    in property <bool> auto-update;
    callback autostart-changed(bool);
    callback language-chosen(string);
    callback theme-chosen(string);
    callback tray-priority-chosen(string);
    callback tray-battery-icon-chosen(bool);
    callback hide-offline-changed(bool);
    callback install-update();
    callback check-updates();
    callback auto-update-changed(bool);
    callback open-folder();
    callback suggest-improvement();

    // A newer version is known: release notes and the install button get room of their own. This includes a
    // failed install with empty release notes, where the button is the only way to try again.
    property <bool> newer: root.install-visible || root.update-notes != "";

    Card {
        VerticalLayout {
            padding: 1px;
            SwitchRow {
                strong: true;
                leading-glyph: "\u{E7E8}";
                leading-color: Palette.accent;
                text: T.t("autostart");
                checked: root.autostart;
                toggled(on) => { root.autostart-changed(on); }
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 1px;
            // Always also says "Language", for someone who can't read the current one
            ControlRow {
                leading-glyph: "\u{E774}";
                text: T.t("lang.header");
                Dropdown {
                    min-width: 150px;
                    label: T.t("lang.header");
                    options: [T.t("lang.auto"), "Русский", "English", "中文"];
                    current: root.language == "ru" ? 1 : root.language == "en" ? 2 : root.language == "zh" ? 3 : 0;
                    selected(i) => { root.language-chosen(["auto", "ru", "en", "zh"][i]); }
                }
            }
            Divider { }
            // As wide as the language's: the two lists line up
            ControlRow {
                leading-glyph: "\u{E790}";
                text: T.t("theme.header");
                Dropdown {
                    min-width: 150px;
                    label: T.t("theme.header");
                    options: [T.t("theme.auto"), T.t("theme.light"), T.t("theme.dark")];
                    current: root.theme == "light" ? 1 : root.theme == "dark" ? 2 : 0;
                    selected(i) => { root.theme-chosen(["auto", "light", "dark"][i]); }
                }
            }
            Divider {}
            ControlRow {
                leading-glyph: "\u{E83F}";
                text: T.t("tray.style");
                Dropdown {
                    min-width: 150px;
                    label: T.t("tray.style");
                    options: [T.t("tray.style.icon"), T.t("tray.style.number")];
                    current: root.tray-battery-icon ? 0 : 1;
                    selected(i) => { root.tray-battery-icon-chosen(i == 0); }
                }
            }
            Divider {}
            HorizontalLayout {
                min-height: 48px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Glyph {
                    width: 20px;
                    text: "\u{E8CB}";
                    font-size: 18px;
                    horizontal-alignment: center;
                }
                Text {
                    text: T.t("tray.priority");
                    color: Palette.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        min-width: 150px;
                        label: T.t("tray.priority");
                        options: [
                            T.t("tray.priority.mouse"),
                            T.t("tray.priority.keyboard"),
                            T.t("tray.priority.bluetooth"),
                            T.t("tray.priority.headset"),
                            T.t("tray.priority.lowest"),
                        ];
                        current: root.tray-priority == "keyboard" ? 1
                            : root.tray-priority == "bluetooth" ? 2
                            : root.tray-priority == "headset" ? 3
                            : root.tray-priority == "lowest" ? 4 : 0;
                        selected(i) => { root.tray-priority-chosen(["mouse", "keyboard", "bluetooth", "headset", "lowest"][i]); }
                    }
                }
            }
            Divider {}
            SwitchRow {
                leading-glyph: "\u{ED1A}";
                text: T.t("hide.offline");
                checked: root.hide-offline;
                toggled(on) => { root.hide-offline-changed(on); }
            }
        }
    }
    VerticalLayout {
        padding-top: 14px;
        padding-left: 2px;
        SectionHeader {
            text: T.t("updates.header");
        }
    }
    Card {
        VerticalLayout {
            padding: 1px;
            if root.newer: VerticalLayout {
                padding-top: 12px;
                padding-right: 16px;
                padding-bottom: 12px;
                padding-left: 16px;
                spacing: 8px;
                Text {
                    text: root.update-status;
                    color: Palette.text;
                    wrap: word-wrap;
                }
                if root.update-notes != "": Hint {
                    text: root.update-notes;
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    alignment: start;
                    if root.install-visible: Btn {
                        accent: true;
                        text: root.install-text;
                        clicked => { root.install-update(); }
                    }
                    Btn {
                        text: T.t("updates.check");
                        enabled: root.check-enabled;
                        clicked => { root.check-updates(); }
                    }
                }
            }
            if !root.newer: HorizontalLayout {
                padding-top: 10px;
                padding-right: 16px;
                padding-bottom: 10px;
                padding-left: 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.update-status;
                        color: Palette.text;
                        wrap: word-wrap;
                    }
                    if root.update-checked-text != "": Hint {
                        text: root.update-checked-text;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        text: T.t("updates.check");
                        enabled: root.check-enabled;
                        clicked => { root.check-updates(); }
                    }
                }
            }
            Divider { }
            SwitchRow {
                text: T.t("updates.auto");
                checked: root.auto-update;
                toggled(on) => { root.auto-update-changed(on); }
            }
        }
    }
    VerticalLayout {
        padding-top: 6px;
        WideButton {
            glyph: "\u{ED25}";
            text: T.t("open.folder");
            clicked => { root.open-folder(); }
        }
    }
    WideButton {
        glyph: "\u{EA80}";
        text: T.t("feedback");
        trailing-glyph: "\u{E8A7}";
        trailing-label: T.t("feedback.browser");
        clicked => { root.suggest-improvement(); }
    }
}

// A sound of the "Sounds" card: what it is for, the list it is chosen from, and a button that plays it (and ends it
// while it plays; with "No sound" chosen there is nothing to play). Under the row, what there is to say about the
// file chosen: that only its beginning will sound, or, in red, that the file picked couldn't be taken.
component SoundRow inherits VerticalLayout {
    in property <string> text;
    in property <[string]> options;
    in property <int> break-a;
    in property <int> break-b;
    in property <int> current;
    in property <bool> silent;
    in property <bool> playing;
    in property <string> note;
    in property <bool> refused;
    callback chosen(int);
    // The ✕ of one of the user's files in the list
    callback removed(int);
    callback preview();
    ControlRow {
        text: root.text;
        HorizontalLayout {
            spacing: 4px;
            // As wide whatever is chosen: a file's long name is cut short
            Dropdown {
                width: 170px;
                label: root.text;
                options: root.options;
                current: root.current;
                break-a: root.break-a;
                break-b: root.break-b;
                // The user's files: after the second line, up to "Custom file…", the last option
                remove-from: root.break-b;
                remove-to: root.options.length - 1;
                remove-label: T.t("sounds.remove");
                selected(i) => { root.chosen(i); }
                removed(i) => { root.removed(i); }
            }
            if !root.silent: TipButton {
                width: 32px;
                height: 32px;
                glyph: root.playing ? "\u{E71A}" : "\u{E768}";
                glyph-size: 13px;
                secondary: true;
                active: root.playing;
                accent: root.playing;
                tip: root.playing ? T.t("sounds.stop") : T.t("sounds.play");
                clicked => { root.preview(); }
            }
            if root.silent: Rectangle {
                width: 32px;
                height: 32px;
                Glyph {
                    text: "\u{E768}";
                    font-size: 13px;
                    color: Palette.offline;
                    horizontal-alignment: center;
                }
            }
        }
    }
    if root.note != "": VerticalLayout {
        padding-right: 16px;
        padding-bottom: 12px;
        padding-left: 16px;
        Text {
            text: root.note;
            font-size: 12px;
            color: root.refused ? Palette.bad : Palette.secondary;
            wrap: word-wrap;
        }
    }
}

// "Reminders": the levels and the repeat interval, each a field and a slider; closing on its own, after a field and a
// slider's seconds; the finished charge; and, in a card of their own, the sounds: of the reminder at each level and
// of the "charged" notice, each chosen from the same list
export component RemindersPage inherits Page {
    in property <int> low;
    in property <int> critical;
    in property <int> repeat;
    in property <bool> notify-charged;
    in property <bool> auto-close;
    in property <int> auto-close-seconds;
    // The list every sound is chosen from; its last line, "Custom file…", is no sound: it adds one
    in property <[string]> sound-options;
    in property <int> sound-break-a;
    in property <int> sound-break-b;
    // Where "No sound" is in the list
    in property <int> sound-none;
    // What each row has chosen
    in property <int> sound-low;
    in property <int> sound-critical;
    in property <int> sound-charged;
    // The row whose sound is playing (0, 1, 2), and the row whose picked file was refused; -1: none
    in property <int> sound-playing: -1;
    in property <int> sound-refused: -1;
    // What is said under each row, "" for nothing
    in property <[string]> sound-notes;
    // One of the number fields has the keyboard focus
    out property <bool> field-focused: low-field.has-focus || critical-field.has-focus || repeat-field.has-focus
        || close-field.has-focus;
    callback low-changed(int);
    callback critical-changed(int);
    callback repeat-changed(int);
    callback sound-chosen(int, int);
    callback sound-preview(int);
    // The ✕ of a file of the user's, in any row's list: the place of the file in the list
    callback sound-removed(int);
    callback notify-charged-changed(bool);
    callback auto-close-changed(bool);
    callback auto-close-seconds-changed(int);
    callback test-alert();
    // A field is done with (Return, or its block closes under it): the window takes the focus back
    callback fields-done();

    // Drops what was typed into the fields: they lose the focus afterwards with nothing to apply
    public function reset-fields() {
        low-field.reset();
        critical-field.reset();
        repeat-field.reset();
        close-field.reset();
    }

    Card {
        VerticalLayout {
            padding: 1px;
            VerticalLayout {
                padding-top: 12px;
                padding-right: 16px;
                padding-bottom: 6px;
                padding-left: 16px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: T.t("alerts.low");
                        color: Palette.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    // The fields take what settings.rs does (LEVEL_PERCENT, REPEAT_MINUTES, AUTO_CLOSE_SECONDS); the
                    // sliders cover the usual part of it
                    low-field := NumberField {
                        label: T.t("alerts.low");
                        value: root.low;
                        minimum: 1;
                        unit: "%";
                        value-color: Palette.accent;
                        changed(v) => { root.low-changed(v); }
                        submitted => { root.fields-done(); }
                    }
                }
                StepSlider {
                    minimum: 10;
                    maximum: 50;
                    label: T.t("alerts.low");
                    value: root.low;
                    changed(v) => { root.low-changed(v); }
                }
            }
            VerticalLayout {
                padding-top: 6px;
                padding-right: 16px;
                padding-bottom: 6px;
                padding-left: 16px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text {
                            text: T.t("alerts.critical");
                            color: Palette.text;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTip {
                                hint: T.t("alerts.critical.hint");
                                label: T.t("alerts.critical.info");
                            }
                        }
                    }
                    critical-field := NumberField {
                        label: T.t("alerts.critical");
                        value: root.critical;
                        minimum: 1;
                        unit: "%";
                        value-color: Palette.accent;
                        changed(v) => { root.critical-changed(v); }
                        submitted => { root.fields-done(); }
                    }
                }
                StepSlider {
                    minimum: 5;
                    maximum: 45;
                    label: T.t("alerts.critical");
                    value: root.critical;
                    changed(v) => { root.critical-changed(v); }
                }
            }
            VerticalLayout {
                padding-top: 6px;
                padding-right: 16px;
                padding-bottom: 12px;
                padding-left: 16px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: T.t("alerts.repeat");
                        color: Palette.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    repeat-field := NumberField {
                        label: T.t("alerts.repeat");
                        value: root.repeat;
                        minimum: 1;
                        maximum: 99999;
                        unit: T.t("alerts.repeat.unit");
                        unit-gap: 4px;
                        value-color: Palette.accent;
                        changed(v) => { root.repeat-changed(v); }
                        submitted => { root.fields-done(); }
                    }
                }
                StepSlider {
                    minimum: 1;
                    maximum: 60;
                    step: 1;
                    label: T.t("alerts.repeat");
                    value: root.repeat;
                    changed(v) => { root.repeat-changed(v); }
                }
            }
            Divider { }
            SwitchRow {
                text: T.t("alerts.autoclose");
                checked: root.auto-close;
                toggled(on) => {
                    // Closing under a field that has the focus: it applies what it holds and gives the focus up
                    if (!on && close-field.has-focus) {
                        close-field.flush();
                        root.fields-done();
                    }
                    root.auto-close-changed(on);
                }
            }
            // Opens and closes smoothly with the switch. The field takes what AUTO_CLOSE_SECONDS in settings.rs does;
            // the slider runs from 1 to 15 seconds and stands at an end for a value past that, as the repeat's does
            Collapsible {
                open: root.auto-close;
                VerticalLayout {
                    padding-right: 16px;
                    padding-bottom: 12px;
                    padding-left: 16px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: T.t("alerts.autoclose.after");
                            color: Palette.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        close-field := NumberField {
                            label: T.t("alerts.autoclose.after");
                            value: root.auto-close-seconds;
                            minimum: 1;
                            maximum: 99999;
                            unit: T.t("alerts.autoclose.unit");
                            unit-gap: 4px;
                            value-color: Palette.accent;
                            changed(v) => { root.auto-close-seconds-changed(v); }
                            submitted => { root.fields-done(); }
                        }
                    }
                    StepSlider {
                        minimum: 1;
                        maximum: 15;
                        step: 1;
                        label: T.t("alerts.autoclose.after");
                        value: root.auto-close-seconds;
                        changed(v) => { root.auto-close-seconds-changed(v); }
                    }
                }
            }
            Divider { }
            SwitchRow {
                text: T.t("charged.toggle");
                hint: T.t("charged.hint");
                hint-label: T.t("charged.info");
                checked: root.notify-charged;
                toggled(on) => { root.notify-charged-changed(on); }
            }
        }
    }
    // The sounds are new in 2.4.0: the badge goes in the next version
    HorizontalLayout {
        padding-top: 14px;
        padding-left: 2px;
        spacing: 8px;
        alignment: start;
        SectionHeader {
            text: T.t("sounds.header");
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            NewBadge { }
        }
    }
    Card {
        VerticalLayout {
            padding: 1px;
            SoundRow {
                text: T.t("sounds.low");
                options: root.sound-options;
                break-a: root.sound-break-a;
                break-b: root.sound-break-b;
                current: root.sound-low;
                silent: root.sound-low == root.sound-none;
                playing: root.sound-playing == 0;
                note: root.sound-notes[0];
                refused: root.sound-refused == 0;
                chosen(i) => { root.sound-chosen(0, i); }
                removed(i) => { root.sound-removed(i); }
                preview => { root.sound-preview(0); }
            }
            Divider { }
            SoundRow {
                text: T.t("sounds.critical");
                options: root.sound-options;
                break-a: root.sound-break-a;
                break-b: root.sound-break-b;
                current: root.sound-critical;
                silent: root.sound-critical == root.sound-none;
                playing: root.sound-playing == 1;
                note: root.sound-notes[1];
                refused: root.sound-refused == 1;
                chosen(i) => { root.sound-chosen(1, i); }
                removed(i) => { root.sound-removed(i); }
                preview => { root.sound-preview(1); }
            }
            // The notice's sound is here while the notice is: it opens and closes with the switch above
            Collapsible {
                open: root.notify-charged;
                Divider { }
                SoundRow {
                    text: T.t("sounds.charged");
                    options: root.sound-options;
                    break-a: root.sound-break-a;
                    break-b: root.sound-break-b;
                    current: root.sound-charged;
                    silent: root.sound-charged == root.sound-none;
                    playing: root.sound-playing == 2;
                    note: root.sound-notes[2];
                    refused: root.sound-refused == 2;
                    chosen(i) => { root.sound-chosen(2, i); }
                    removed(i) => { root.sound-removed(i); }
                    preview => { root.sound-preview(2); }
                }
            }
        }
    }
    VerticalLayout {
        padding-top: 4px;
        WideButton {
            glyph: "\u{EA8F}";
            text: T.t("alerts.test");
            clicked => { root.test-alert(); }
        }
    }
}

// "Overlay": the shortcut that shows the overlay, how long it stays, where, and with names or not
export component OverlayPage inherits Page {
    in property <bool> overlay-enabled;
    in property <[string]> shortcut-keys;
    in property <string> shortcut-text;
    in property <string> shortcut-error;
    in property <int> overlay-mode;
    in property <int> overlay-corner;
    in property <bool> overlay-names;
    // The shortcut field has the keyboard focus: it records
    out property <bool> shortcut-focused: shortcut.recording;
    callback overlay-enabled-changed(bool);
    callback overlay-mode-chosen(int);
    callback overlay-corner-chosen(int);
    callback overlay-names-changed(bool);
    callback overlay-reset();
    callback overlay-preview();

    Card {
        VerticalLayout {
            padding: 1px;
            SwitchRow {
                text: T.t("overlay.enabled");
                hint: T.t("overlay.compatibility");
                hint-label: T.t("overlay.info");
                checked: root.overlay-enabled;
                toggled(on) => { root.overlay-enabled-changed(on); }
            }
            Divider { }
            ControlRow {
                text: T.t("overlay.shortcut");
                HorizontalLayout {
                    spacing: 4px;
                    shortcut := ShortcutField {
                        keys: root.shortcut-keys;
                        text: root.shortcut-text;
                        label: T.t("overlay.shortcut");
                    }
                    TipButton {
                        width: 32px;
                        height: 32px;
                        glyph: "\u{E7A7}";
                        glyph-size: 13px;
                        secondary: true;
                        tip: T.t("overlay.reset");
                        clicked => { root.overlay-reset(); }
                    }
                }
            }
            // Why the shortcut wasn't taken: under its row, inside the card
            if root.shortcut-error != "": VerticalLayout {
                padding-right: 16px;
                padding-bottom: 12px;
                padding-left: 16px;
                Text {
                    text: root.shortcut-error;
                    font-size: 12px;
                    color: Palette.bad;
                    wrap: word-wrap;
                }
            }
            Divider { }
            ControlRow {
                text: T.t("overlay.mode");
                Dropdown {
                    min-width: 190px;
                    label: T.t("overlay.mode");
                    options: [T.t("overlay.timed"), T.t("overlay.toggle")];
                    current: root.overlay-mode;
                    selected(i) => { root.overlay-mode-chosen(i); }
                }
            }
            Divider { }
            ControlRow {
                text: T.t("overlay.corner");
                Dropdown {
                    min-width: 190px;
                    label: T.t("overlay.corner");
                    options: [
                        T.t("overlay.top.left"),
                        T.t("overlay.top.right"),
                        T.t("overlay.bottom.left"),
                        T.t("overlay.bottom.right"),
                    ];
                    current: root.overlay-corner;
                    selected(i) => { root.overlay-corner-chosen(i); }
                }
            }
            Divider { }
            SwitchRow {
                text: T.t("overlay.names");
                checked: root.overlay-names;
                toggled(on) => { root.overlay-names-changed(on); }
            }
        }
    }
    VerticalLayout {
        padding-top: 4px;
        WideButton {
            glyph: "\u{E890}";
            text: T.t("overlay.preview");
            clicked => { root.overlay-preview(); }
        }
    }
}

// The main window: the devices screen and the settings screen, stacked and hidden rather than destroyed, and
// above them the layers of what can be open over everything: the lifted device of a drag, the device menu, a
// dropdown list, the admin rights window, a tooltip. Every text and value comes from Rust; edits go back through the callbacks. The
// window's own state (the screen, what is open) is the UI's; Rust resets it through `reset-screen`.

import { Palette, T, Card, Glyph, Btn } from "theme.slint";
import { Tip, TipLayer, DropdownList, DropdownLayer } from "controls.slint";
import { DeviceItem, DeviceUi, Drag, DeviceView, DevicesScreen, DeviceMenu } from "devices.slint";
import { SettingsScreen, GeneralPage, RemindersPage, OverlayPage } from "settings.slint";

export component MainWindow inherits Window {
    title: T.t("app.title");
    preferred-width: 440px;
    preferred-height: root.panel-height;
    min-width: 400px;
    min-height: root.screen == 0 ? 0px : 420px;
    background: Palette.window;
    // Chinese in its own font: the fallback Windows picks for Han on a non-Chinese system is Japanese, which lacks
    // the simplified characters. Microsoft YaHei UI has Latin and Cyrillic too.
    default-font-family: T.lang == "zh" ? "Microsoft YaHei UI" : "Segoe UI";
    default-font-size: 13px;
    // Keys go to `keys` until something inside takes the focus
    forward-focus: keys;

    // Device list: each model is made once by Rust and then only changed row by row
    in property <[DeviceItem]> pinned-devices;
    in property <[DeviceItem]> connected-devices;
    in property <[DeviceItem]> offline-devices;
    in property <[DeviceItem]> hidden-devices;
    in property <bool> none-online;
    in property <string> updated-text;
    in property <string> version-text;
    in property <bool> banner-visible;
    in property <string> banner-text;
    in property <bool> banner-button-visible;
    in property <bool> autostart;
    in property <bool> autostart-banner-dismissed;
    in property <bool> admin-banner;
    in property <bool> animate-banners: true;

    // Settings / General
    in property <string> language;
    in property <string> theme;
    in property <string> tray-priority;
    in property <bool> tray-battery-icon;
    in property <bool> hide-offline;
    in property <string> update-status;
    in property <string> update-checked-text;
    in property <string> update-notes;
    in property <bool> install-visible;
    in property <string> install-text;
    in property <bool> check-enabled: true;
    in property <bool> auto-update;
    // Settings / Reminders
    in property <int> low;
    in property <int> critical;
    in property <int> repeat;
    // The sounds: the list each is chosen from (with the places of its two lines and of "No sound"), what each of the
    // three rows has chosen, the row that is playing, the row whose file was refused, the note under each row
    in property <[string]> sound-options;
    in property <int> sound-break-a;
    in property <int> sound-break-b;
    in property <int> sound-none;
    in property <int> sound-low;
    in property <int> sound-critical;
    in property <int> sound-charged;
    in property <int> sound-playing: -1;
    in property <int> sound-refused: -1;
    in property <[string]> sound-notes;
    in property <bool> notify-charged;
    in property <bool> auto-close;
    in property <int> auto-close-seconds;
    // Settings / Overlay
    in property <bool> overlay-enabled;
    in property <[string]> shortcut-keys;
    in property <string> shortcut-text;
    in property <string> shortcut-error;
    in property <int> overlay-mode;
    in property <int> overlay-corner;
    in property <bool> overlay-names;

    // The UI's own state
    in-out property <int> screen: 0;
    in-out property <int> settings-tab: 0;
    in-out property <bool> hidden-open: false;
    // The device list can shrink to its contents and keeps its original viewport limit for long lists.
    out property <length> panel-height: root.screen == 0 ? min(640px, devices.panel-height) : 640px;
    callback panel-height-changed();
    changed panel-height => { root.panel-height-changed(); }
    // The window that says what granting admin rights does, before Windows asks
    in-out property <bool> admin-dialog: false;
    // What Rust reads
    out property <string> menu-id: DeviceUi.menu-id;
    out property <string> renaming-id: DeviceUi.renaming-id;
    out property <int> drag-list: Drag.list;
    // Derived from what is on screen, so it can't go stale: leaving the tab or the screen takes the focus away
    out property <bool> recording-shortcut: root.screen == 1 && root.settings-tab == 2 && overlay.shortcut-focused;

    callback refresh();
    callback install-update();
    callback check-updates();
    callback language-chosen(language: string);
    callback theme-chosen(theme: string);
    callback tray-priority-chosen(priority: string);
    callback tray-battery-icon-chosen(enabled: bool);
    callback hide-offline-changed(on: bool);
    callback test-alert();
    callback open-folder();
    callback suggest-improvement();
    callback autostart-changed(on: bool);
    callback dismiss-autostart-banner();
    callback grant-admin();
    callback dismiss-admin-banner();
    callback auto-update-changed(on: bool);
    callback low-changed(value: int);
    callback critical-changed(value: int);
    callback repeat-changed(value: int);
    // A row of the sounds (0 low, 1 critical, 2 charged) and the line chosen in its list; a row's play button
    callback sound-chosen(event: int, index: int);
    callback sound-preview(event: int);
    // The ✕ of one of the user's files in a list of sounds: its place in the list
    callback sound-removed(index: int);
    callback notify-charged-changed(on: bool);
    callback auto-close-changed(on: bool);
    callback auto-close-seconds-changed(value: int);
    callback overlay-enabled-changed(on: bool);
    callback overlay-mode-chosen(mode: int);
    callback overlay-corner-chosen(corner: int);
    callback overlay-names-changed(on: bool);
    callback overlay-reset();
    callback overlay-preview();
    callback device-renamed(id: string, text: string);
    callback device-pinned-changed(id: string, pinned: bool);
    callback device-hidden-changed(id: string, hidden: bool);
    callback device-moved(id: string, onto: string);
    callback device-alerts-changed(id: string, on: bool);
    callback device-low-changed(id: string, value: int);
    callback device-critical-changed(id: string, value: int);
    callback device-levels-reset(id: string);

    // The functions Rust calls. None of the first six raises a callback, also not through a change handler, so Rust
    // may call them while it holds the app's state: typed text is dropped, never applied.

    // Closes or cancels the topmost thing, one per press: the admin rights window, tooltip, dropdown list, device menu,
    // rename, drag, shortcut recording, a settings field being typed into, the settings screen. Returns whether there
    // was something.
    public function escape() -> bool {
        if (root.admin-dialog) {
            root.admin-dialog = false;
            return true;
        }
        if (tips.showing) {
            Tip.cancel();
            return true;
        }
        if (DropdownList.open) {
            DropdownList.close();
            return true;
        }
        if (DeviceUi.menu-id != "") {
            root.shut-menu(false);
            keys.focus();
            return true;
        }
        if (DeviceUi.renaming-id != "") {
            root.end-rename(false);
            return true;
        }
        if (Drag.active) {
            Drag.cancel();
            return true;
        }
        if (overlay.shortcut-focused) {
            keys.focus();
            return true;
        }
        if (reminders.field-focused) {
            reminders.reset-fields();
            keys.focus();
            return true;
        }
        if (root.screen == 1) {
            // A tooltip about to show would come up over the other screen: the pointer has not left its anchor
            Tip.cancel();
            root.screen = 0;
            keys.focus();
            return true;
        }
        false
    }
    // As the window is when it opens: everything closed, typed text dropped, on the devices or on the settings
    public function reset-screen(settings: bool) {
        Tip.cancel();
        DropdownList.close();
        root.shut-menu(false);
        root.end-rename(false);
        Drag.cancel();
        reminders.reset-fields();
        root.hidden-open = false;
        root.admin-dialog = false;
        root.screen = settings ? 1 : 0;
        root.settings-tab = 0;
        keys.focus();
    }
    // The device menu closes, what its fields hold is dropped (its device is gone)
    public function close-menu() {
        let had-focus = menu.field-focused;
        root.shut-menu(false);
        if (had-focus) {
            keys.focus();
        }
    }
    public function cancel-rename() {
        root.end-rename(false);
    }
    public function cancel-drag() {
        Drag.cancel();
    }
    // A shortcut was taken: the field gives up the focus, so its key caps show
    public function shortcut-recorded() {
        keys.focus();
    }

    // These may raise callbacks. Rust calls `deactivated` only from a timer, never while it holds the app's state;
    // the other two are what clicks do, public for the snapshot example and the tests.

    // The window lost the focus: whatever is open closes, what was typed is applied, a drag ends without a move
    public function deactivated() {
        // Both give the focus back to the window itself when they close the menu or end a rename, and only then: a
        // shortcut being recorded goes on when the window comes back
        root.close-popups();
        Drag.cancel();
        root.end-rename(true);
    }
    public function open-menu(id: string) {
        Tip.cancel();
        DropdownList.close();
        root.end-rename(true);
        root.shut-menu(true);
        menu.reset();
        // The menu is one layer for every device: it opens with the values of this one, without animating to them
        DeviceUi.menu-instant = true;
        DeviceUi.menu-id = id;
    }
    // The device's name becomes a field; the field fills itself in and takes the focus when it appears
    public function start-rename(id: string) {
        Tip.cancel();
        root.end-rename(true);
        root.shut-menu(true);
        DeviceUi.renaming-id = id;
    }

    // Closes the device menu, applying what its fields hold or dropping it
    function shut-menu(save: bool) {
        if (DeviceUi.menu-id == "") {
            return;
        }
        if (save) {
            menu.flush();
        } else {
            menu.reset();
        }
        DeviceUi.menu-id = "";
    }
    // Menu, list and tooltip: gone, a level typed into the menu applied
    function close-popups() {
        Tip.cancel();
        DropdownList.close();
        if (DeviceUi.menu-id != "") {
            root.shut-menu(true);
            keys.focus();
        }
    }
    // The name typed so far is the window's, not the field's, so this works whatever became of the field. It is
    // over before the focus moves: the field's own loss of focus then finds no rename to save.
    function end-rename(save: bool) {
        if (DeviceUi.renaming-id == "") {
            return;
        }
        let id = DeviceUi.renaming-id;
        DeviceUi.renaming-id = "";
        keys.focus();
        if (save) {
            root.device-renamed(id, DeviceUi.rename-text);
        }
    }
    // A drag that starts ends a rename too, but the name is saved only once the drag is over: saved at once, the
    // list's refresh could change the block under the drag (a new name moves its device in the automatic order,
    // a device held back for its field goes to its block) and so end the drag as it starts
    property <string> drag-renamed-id;
    property <string> drag-renamed-text;
    function end-rename-for-drag() {
        if (DeviceUi.renaming-id == "") {
            return;
        }
        root.drag-renamed-id = DeviceUi.renaming-id;
        root.drag-renamed-text = DeviceUi.rename-text;
        root.end-rename(false);
    }
    // From the event loop: also a drag that cancel-drag() or reset-screen() ended, while Rust holds the app's state,
    // gets its name saved after Rust is done
    Timer {
        interval: 0ms;
        running: root.drag-renamed-id != "" && !Drag.active;
        triggered => {
            let id = root.drag-renamed-id;
            root.drag-renamed-id = "";
            root.device-renamed(id, root.drag-renamed-text);
        }
    }
    function open-settings() {
        root.end-rename(true);
        root.close-popups();
        root.screen = 1;
        root.settings-tab = 0;
        keys.focus();
    }

    // The anchors of what is open move with the window's size
    changed width => {
        root.close-popups();
    }
    changed height => {
        root.close-popups();
    }

    // Around everything: tells the tooltips where the pointer is
    pointer := TouchArea {
        // Escape is the window's, before whatever has the focus sees it
        keys := FocusScope {
            capture-key-pressed(e) => {
                e.text == Key.Escape && root.escape() ? accept : reject
            }

            devices := DevicesScreen {
                visible: root.screen == 0;
                pinned: root.pinned-devices;
                connected: root.connected-devices;
                offline: root.offline-devices;
                hidden: root.hidden-devices;
                none-online: root.none-online;
                updated-text: root.updated-text;
                version-text: root.version-text;
                banner-visible: root.banner-visible;
                banner-text: root.banner-text;
                banner-button-visible: root.banner-button-visible;
                autostart-banner: !root.autostart && !root.autostart-banner-dismissed;
                admin-banner: root.admin-banner;
                animate-banners: root.animate-banners;
                hidden-open <=> root.hidden-open;
                refresh => { root.refresh(); }
                open-settings => { root.open-settings(); }
                install-update => { root.install-update(); }
                enable-autostart => { root.autostart-changed(true); }
                dismiss-autostart-banner => { root.dismiss-autostart-banner(); }
                grant-admin-asked => {
                    root.end-rename(true);
                    root.close-popups();
                    root.admin-dialog = true;
                }
                dismiss-admin-banner => { root.dismiss-admin-banner(); }
                open-menu(id) => { root.open-menu(id); }
                rename-done => { root.end-rename(true); }
                drag-started => {
                    Tip.cancel();
                    root.end-rename-for-drag();
                }
                device-moved(id, onto) => { root.device-moved(id, onto); }
                device-shown(id) => { root.device-hidden-changed(id, false); }
            }
            SettingsScreen {
                visible: root.screen == 1;
                tab: root.settings-tab;
                back => {
                    Tip.cancel();
                    root.screen = 0;
                    keys.focus();
                }
                // A field of the page that goes loses the focus because it is hidden, and commits; then the window
                // holds the focus, or no key would reach anyone
                tab-clicked(i) => {
                    Tip.cancel();
                    root.settings-tab = i;
                    keys.focus();
                }
                GeneralPage {
                    visible: root.settings-tab == 0;
                    autostart: root.autostart;
                    language: root.language;
                    theme: root.theme;
                    tray-priority: root.tray-priority;
                    tray-battery-icon: root.tray-battery-icon;
                    hide-offline: root.hide-offline;
                    update-status: root.update-status;
                    update-checked-text: root.update-checked-text;
                    update-notes: root.update-notes;
                    install-visible: root.install-visible;
                    install-text: root.install-text;
                    check-enabled: root.check-enabled;
                    auto-update: root.auto-update;
                    autostart-changed(on) => { root.autostart-changed(on); }
                    language-chosen(language) => { root.language-chosen(language); }
                    theme-chosen(theme) => { root.theme-chosen(theme); }
                    tray-battery-icon-chosen(enabled) => { root.tray-battery-icon-chosen(enabled); }
                    tray-priority-chosen(priority) => { root.tray-priority-chosen(priority); }
                    hide-offline-changed(on) => { root.hide-offline-changed(on); }
                    install-update => { root.install-update(); }
                    check-updates => { root.check-updates(); }
                    auto-update-changed(on) => { root.auto-update-changed(on); }
                    open-folder => { root.open-folder(); }
                    suggest-improvement => { root.suggest-improvement(); }
                }
                reminders := RemindersPage {
                    visible: root.settings-tab == 1;
                    low: root.low;
                    critical: root.critical;
                    repeat: root.repeat;
                    sound-options: root.sound-options;
                    sound-break-a: root.sound-break-a;
                    sound-break-b: root.sound-break-b;
                    sound-none: root.sound-none;
                    sound-low: root.sound-low;
                    sound-critical: root.sound-critical;
                    sound-charged: root.sound-charged;
                    sound-playing: root.sound-playing;
                    sound-refused: root.sound-refused;
                    sound-notes: root.sound-notes;
                    notify-charged: root.notify-charged;
                    auto-close: root.auto-close;
                    auto-close-seconds: root.auto-close-seconds;
                    low-changed(v) => { root.low-changed(v); }
                    critical-changed(v) => { root.critical-changed(v); }
                    repeat-changed(v) => { root.repeat-changed(v); }
                    sound-chosen(event, index) => { root.sound-chosen(event, index); }
                    sound-removed(index) => { root.sound-removed(index); }
                    sound-preview(event) => { root.sound-preview(event); }
                    notify-charged-changed(on) => { root.notify-charged-changed(on); }
                    auto-close-changed(on) => { root.auto-close-changed(on); }
                    auto-close-seconds-changed(v) => { root.auto-close-seconds-changed(v); }
                    test-alert => { root.test-alert(); }
                    fields-done => { keys.focus(); }
                }
                overlay := OverlayPage {
                    visible: root.settings-tab == 2;
                    overlay-enabled: root.overlay-enabled;
                    shortcut-keys: root.shortcut-keys;
                    shortcut-text: root.shortcut-text;
                    shortcut-error: root.shortcut-error;
                    overlay-mode: root.overlay-mode;
                    overlay-corner: root.overlay-corner;
                    overlay-names: root.overlay-names;
                    overlay-enabled-changed(on) => { root.overlay-enabled-changed(on); }
                    overlay-mode-chosen(mode) => { root.overlay-mode-chosen(mode); }
                    overlay-corner-chosen(corner) => { root.overlay-corner-chosen(corner); }
                    overlay-names-changed(on) => { root.overlay-names-changed(on); }
                    overlay-reset => { root.overlay-reset(); }
                    overlay-preview => { root.overlay-preview(); }
                }
            }

            // The layers, last: above both screens, outside every scroll view, first to get pointer events.
            // The device being dragged follows the pointer up and down inside the list's frame and, as in the
            // mockup, stands 12px to the right of its place. Its data is read from its block by index: a block
            // can't change under a drag (Rust cancels the drag first).
            if Drag.active: DeviceView {
                x: Drag.card-x + 12px;
                y: max(devices.frame-y, min(devices.frame-y + devices.frame-height - self.height, Drag.top));
                width: Drag.card-width;
                height: Drag.card-height;
                item: Drag.list == 0 ? root.pinned-devices[Drag.source]
                    : Drag.list == 1 ? root.connected-devices[Drag.source]
                    : root.offline-devices[Drag.source];
                as-row: Drag.list == 2;
                lifted: true;
                drop-shadow-offset-y: 12px;
                drop-shadow-blur: 28px;
                drop-shadow-color: Palette.lift-shadow;
            }
            menu := DeviceMenu {
                general-low: root.low;
                general-critical: root.critical;
                dismiss => {
                    root.shut-menu(true);
                    keys.focus();
                }
                rename => { root.start-rename(DeviceUi.menu-id); }
                pin-toggled => {
                    let id = DeviceUi.menu-id;
                    let pinned = DeviceUi.menu-device.pinned;
                    root.shut-menu(true);
                    keys.focus();
                    root.device-pinned-changed(id, !pinned);
                }
                hide => {
                    let id = DeviceUi.menu-id;
                    root.shut-menu(true);
                    keys.focus();
                    root.device-hidden-changed(id, true);
                }
                // Turned off, the levels block closes: a level field that has the focus gives it up first, and
                // applies what it holds as it does
                alerts-toggled => {
                    let alerts = DeviceUi.menu-device.alerts;
                    if (alerts && self.field-focused) {
                        keys.focus();
                    }
                    DeviceUi.menu-instant = false;
                    root.device-alerts-changed(DeviceUi.menu-id, !alerts);
                }
                low-changed(v) => {
                    DeviceUi.menu-instant = false;
                    root.device-low-changed(DeviceUi.menu-id, v);
                }
                levels-done => { keys.focus(); }
                critical-changed(v) => {
                    DeviceUi.menu-instant = false;
                    root.device-critical-changed(DeviceUi.menu-id, v);
                }
                // A level being typed is dropped: applied as its field loses the focus later, it would give the
                // device its own levels again
                levels-reset => {
                    if (self.field-focused) {
                        self.reset();
                        keys.focus();
                    }
                    DeviceUi.menu-instant = false;
                    root.device-levels-reset(DeviceUi.menu-id);
                }
            }
            DropdownLayer { }
            // Over everything, the rest of the window out of reach until it is answered
            if root.admin-dialog: Rectangle {
                background: Palette.dialog-scrim;
                TouchArea { }
                Card {
                    x: 20px;
                    width: parent.width - 40px;
                    height: dialog.preferred-height;
                    y: (parent.height - self.height) / 2;
                    background: Palette.popup;
                    border-color: Palette.popup-stroke;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: Palette.shadow;
                    dialog := VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 10px;
                            Glyph {
                                text: "\u{E7EF}";
                                font-size: 18px;
                                color: Palette.warn;
                            }
                            Text {
                                text: T.t("admin.dialog.title");
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.text;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                        Text {
                            text: T.t("admin.dialog.text");
                            color: Palette.text;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 4px;
                            spacing: 8px;
                            alignment: end;
                            Btn {
                                text: T.t("admin.dialog.cancel");
                                clicked => {
                                    root.admin-dialog = false;
                                    keys.focus();
                                }
                            }
                            Btn {
                                accent: true;
                                text: T.t("admin.dialog.continue");
                                clicked => {
                                    root.admin-dialog = false;
                                    keys.focus();
                                    root.grant-admin();
                                }
                            }
                        }
                    }
                }
            }
            tips := TipLayer {
                pointer-inside: pointer.has-hover;
                pointer-x: pointer.mouse-x;
                pointer-y: pointer.mouse-y;
            }
        }
    }
}
